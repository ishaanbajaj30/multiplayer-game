# Copy to .env and paste your Firebase web app config values.
# Leave these blank to run the app on a localStorage-only backend (no sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base path for GitHub Pages (defaults to /couple-arcade/)
# VITE_BASE=/couple-arcade/
