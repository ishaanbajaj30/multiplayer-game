// TEMPORARY bootstrap rules — any anonymous client can read/write.
// Safe enough while the app only runs on localhost.
// Swap to firestore.rules (UID allowlist) before deploying publicly.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
